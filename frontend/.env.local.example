# Deployed contract address (from scripts/deploy.js output)
NEXT_PUBLIC_LOTTERY_ADDRESS=0xYourContractAddressHere

# WalletConnect project ID — get one free at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Target chain ID: 11155111 = Sepolia, 1 = Mainnet
NEXT_PUBLIC_CHAIN_ID=11155111
